# Copy to .env and adjust. All values shown are the built-in defaults.
HTTP_ADDR=:8080
DATABASE_URL=postgres://webhooks:webhooks@localhost:5433/webhooks?sslmode=disable
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=info

WORKER_CONCURRENCY=10
DELIVERY_TIMEOUT=10s
MAX_ATTEMPTS=8
BACKOFF_BASE=5s
BACKOFF_MAX=1h
LEASE_DURATION=60s
POLL_INTERVAL=500ms
